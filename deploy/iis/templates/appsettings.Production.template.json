// ===========================================================================
// Cấu hình riêng của MÁY CHỦ này. Deploy-Iis.ps1 chỉ tạo file lần đầu và
// KHÔNG BAO GIỜ ghi đè ở các lần nâng cấp sau - mọi giá trị điền ở đây giữ nguyên.
//
// Mọi chỗ ghi DIEN_VAO_DAY là bắt buộc phải thay. Còn nguyên chữ đó thì API
// không khởi động được (script cũng cảnh báo trước).
//
// KHÔNG commit file này lên git: nó chứa mật khẩu CSDL và khóa ký token.
// ===========================================================================
{
  "ConnectionStrings": {
    // PostgreSQL của đơn vị. Cài trên chính máy chủ thì Host=localhost.
    "KnowledgeDatabase": "Host=localhost;Port=5432;Database=hackathon_ai;Username=postgres;Password=DIEN_VAO_DAY"
  },

  // Origin của web-admin, dùng cho các endpoint quản trị.
  // Cài kiểu proxy (mặc định): web và API cùng origin nên chỉ cần liệt kê tên miền web.
  // Cài kiểu 2 site riêng (-NoProxy): phải là đúng origin trình duyệt đang mở.
  "Cors": {
    "WebAdminOrigins": [ "https://cbyts.benhvien.vn", "http://localhost" ]
  },

  "Jwt": {
    // Chuỗi ngẫu nhiên >= 32 ký tự, mỗi máy chủ một khóa khác nhau. Sinh nhanh:
    //   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
    // Đổi khóa này = mọi phiên đăng nhập hiện có bị đăng xuất.
    "SecretKey": "DIEN_VAO_DAY",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },

  "Seed": {
    // Mật khẩu tài khoản quản trị đầu tiên, chỉ dùng lúc khởi tạo CSDL trống.
    // Đăng nhập xong nên đổi mật khẩu trong màn hình Hồ sơ.
    "AdminPassword": "DIEN_VAO_DAY"
  },

  // Bán theo cơ sở KCB. Lộ trình: Off (chỉ ghi sổ sản lượng) -> Warn (cảnh báo
  // máy trạm chưa khai khóa) -> Enforce (chặn thật). Xem docs/FEATURES.md mục 7.
  "Licensing": {
    "Mode": "Off",
    "RecordBilling": true
  },

  // Trợ lý AI. Không có khóa vẫn chạy đủ rule engine, chỉ mất phần nhận định AI.
  // Dùng AI chạy nội bộ (không ra internet) thì đặt Provider = "Ollama",
  // BaseUrl = "http://localhost:11434", Model = tên model đã tải.
  "LLM": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "Model": "openai/gpt-4o-mini"
  },

  // Chỉ mục ngữ nghĩa cho kho tri thức. Không có Ollama trên máy chủ thì đặt
  // Enabled = false, tìm kiếm lùi về full-text (vẫn dùng được).
  "Embedding": {
    "Enabled": false,
    "OllamaUrl": "http://localhost:11434"
  },

  // Gửi mail đặt lại mật khẩu. Bỏ trống Host = tắt tính năng quên mật khẩu.
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Chiến binh y tế số",
    "WebAppBaseUrl": "https://cbyts.benhvien.vn"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
