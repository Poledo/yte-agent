# Mẫu biến môi trường cho AIValidation.Api.
# Chép thành .env (đã bị .gitignore chặn) rồi điền giá trị thật, hoặc khai báo
# thẳng trong K8s Secret cbyts-secrets (xem k8s/api-validation.yaml).
# Quy ước ASP.NET Core: dấu hai chấm trong khóa cấu hình viết thành hai gạch dưới.

# --- Bắt buộc ---
# Chuỗi kết nối PostgreSQL (có pgvector). Thiếu biến này API dừng ngay lúc khởi động.
ConnectionStrings__KnowledgeDatabase=Host=postgres;Port=5432;Database=hackathon_ai;Username=postgres;Password=

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên.
Jwt__SecretKey=

# Mật khẩu tài khoản admin được tạo lần đầu chạy.
Seed__AdminPassword=

# --- LLM ---
# Khóa OpenRouter dạng sk-or-... Để rỗng thì API tự chuyển sang Ollama nội bộ.
LLM__ApiKey=
LLM__Model=openai/gpt-4o-mini
LLM__OfflineBaseUrl=http://ollama:11434
LLM__OfflineModel=qwen2.5:3b-instruct

# --- Embedding ---
Embedding__OllamaUrl=http://ollama:11434

# --- CORS ---
# Origin của web-admin. Nhiều giá trị thì đánh số: Cors__WebAdminOrigins__0, __1, ...
Cors__WebAdminOrigins__0=https://cbyts.vnpt.vn

# --- Đăng nhập ngoài (tùy chọn) ---
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=

# --- Email gửi thư mời / đặt lại mật khẩu (tùy chọn) ---
Email__Host=smtp.gmail.com
Email__User=
Email__Password=
Email__From=

# --- Bản quyền ---
# Khóa AES-256 mã hóa bản lưu của khóa bản quyền (base64 của 32 byte, tạo bằng
# openssl rand -base64 32). Để rỗng thì cấp khóa vẫn chạy, chỉ không xem lại được
# khóa đã cấp. Đã đặt rồi thì ĐỪNG đổi: đổi key là mọi bản mã cũ không giải được.
Licensing__EncryptionKey=
