<?xml version="1.0" encoding="utf-8"?>
<!--
  Nới giới hạn kích thước request của IIS / IIS Express (mặc định ~30MB).
  Cần cho endpoint kiểm tra lô nhiều file XML 130 (/api/xml130/validate-batch):
  gửi cả tháng file một lần có thể vài trăm MB — vượt mặc định là IIS cắt kết nối,
  extension chỉ thấy "Failed to fetch" và báo nhầm "không kết nối được máy chủ".
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 1 GB (bytes) -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
