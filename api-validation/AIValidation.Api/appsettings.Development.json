{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Chuỗi kết nối KHÔNG để trong file này (bị commit). Chạy một lần trên máy dev:
  //   dotnet user-secrets set "ConnectionStrings:KnowledgeDatabase" "Host=localhost;Port=5432;Database=hackathon_ai;Username=postgres;Password=<mật khẩu máy bạn>"
  // hoặc đặt biến môi trường ConnectionStrings__KnowledgeDatabase.
  "ConnectionStrings": {
    "KnowledgeDatabase": "Host=localhost;Port=5432;Database=hackathon_ai;Username=postgres;Password=Vnpt@1234"
  },
  // Web-admin chạy local bằng ng serve.
  "Cors": {
    "WebAdminOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  // OpenRouter: gateway đa model, hỗ trợ FallbackModels (tự nhảy model kế tiếp khi
  // model chính lỗi/rate-limit). ApiKey để rỗng ở đây — nạp qua user-secrets
  // (LLM:ApiKey) để không lọt vào git. Cần key OpenRouter dạng sk-or-...
  "LLM": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "Model": "openai/gpt-4o-mini",
    "FallbackModels": [
      "google/gemini-2.0-flash-exp:free",
      "qwen/qwen3-next-80b-a3b-instruct:free"
    ],
    "TimeoutSeconds": 60,
    "Temperature": 0,
    "MaxTokens": 4096
  },
  //"LLM": {
  //  "Provider": "Ollama",
  //  "BaseUrl": "http://localhost:11434",
  //  "Model": "qwen2.5:7b-instruct",
  //  "TimeoutSeconds": 120
  //},
  "Prompt": {
    "Folder": "Prompts"
  },
  "Knowledge": {
    "Folder": "Knowledge"
  },
  "Validation": {
    "EnableKnowledge": true,
    "EnableLogging": true,
    "EnableCache": true
  }
}

