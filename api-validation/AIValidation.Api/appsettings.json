{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Chuỗi kết nối để rỗng trong mã nguồn. Nạp lúc chạy theo thứ tự ưu tiên:
  //   - Máy dev:     dotnet user-secrets set "ConnectionStrings:KnowledgeDatabase" "..."
  //   - K8s/Docker:  biến môi trường ConnectionStrings__KnowledgeDatabase (Secret cbyts-secrets)
  // Bỏ trống ở đây thì API dừng ngay lúc khởi động kèm thông báo, không chạy nửa vời.
  "ConnectionStrings": {
    "KnowledgeDatabase": ""
  },
  // Origin được phép gọi các endpoint quản trị (web-admin). Extension Chrome dùng
  // policy riêng vì origin chrome-extension://<id> đổi theo từng máy cài.
  "Cors": {
    "WebAdminOrigins": [ "https://cbyts.vnpt.vn" ]
  },
  // Phân quyền động: danh mục quyền do bộ quét endpoint sinh ra, vai trò chỉ là một
  // tập mã quyền sửa được ở màn hình quản trị.
  //
  // Mode = "Audit" cho đợt chuyển đổi đầu tiên: request thiếu quyền VẪN ĐI TIẾP, chỉ
  // ghi một dòng vào nhật ký từ chối. Vì đợt này bỏ hẳn 19 mã quyền cũ, bật "Enforce"
  // ngay sẽ khoá cửa mọi tài khoản mà bảng dịch mã cũ bỏ sót. Soi
  // /api/permissions/audit-logs vài ngày, cấp bù quyền còn thiếu rồi mới đổi "Enforce".
  "Rbac": {
    "Enabled": true,
    "Mode": "Audit",
    "AutoScanOnStartup": true,
    "AutoGrantToRoleCode": "ADMIN",
    "CacheSeconds": 300,
    "LogDeniedToDatabase": true,
    "IncludeRoutePrefixes": [ "api/" ]
  },
  "Embedding": {
    "Enabled": true,
    "OllamaUrl": "http://localhost:11434",
    "Model": "bge-m3",
    "UsePgvector": true,
    "Dimensions": 1024,
    "BatchSize": 32,
    "Parallel": 2
  },
  "LLM": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "Model": "openai/gpt-4o-mini",
    "TimeoutSeconds": 60,
    "Temperature": 0,
    "MaxTokens": 4096
  },
  "Prompt": {
    "Folder": "Prompts",
    "ValidationSystem": "validation.system",
    "ValidationUser": "validation.user",
    "ExplanationSystem": "explanation.system",
    "ExplanationUser": "explanation.user"
  },
  "Knowledge": {
    "Folder": "Knowledge"
  },
  "Validation": {
    "EnableKnowledge": true,
    "EnableLogging": true,
    "EnableCache": true
  },
  "Licensing": {
    "Mode": "Enforce",
    "RecordBilling": true,
    "HeaderName": "X-License-Key",
    "EncryptionKey": ""
  },
  "Jwt": {
    "Issuer": "AIValidation.Api",
    "Audience": "AIValidation.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "AdminPassword": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Chiến binh y tế số",
    "WebAppBaseUrl": "https://cbyts.vnpt.vn"
  }
}


