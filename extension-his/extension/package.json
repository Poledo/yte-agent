{
  "name": "ai-validation-agent",
  "version": "1.0.0",
  "description": "ZeroCheck AI for data validation on websites",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode robot3d && vite build --mode content && node -e \"require('fs').copyFileSync('public/manifest.json','dist/manifest.json')\"",
    "watch": "vite build --watch",
    "watch:content": "vite build --mode content --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.0.246",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
